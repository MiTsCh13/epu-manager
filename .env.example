# ── Frontend (landet im Browser-Bundle – nur öffentliche Werte!) ──
VITE_SUPABASE_URL=https://<projekt-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_APP_NAME=Klaro
VITE_APP_URL=http://localhost:5173
# Abo-Pflicht mit Testphase/Paywall/Stripe – leer bzw. false = Klaro ist kostenlos
VITE_BILLING_ENABLED=false

# ── Server-only (Supabase Edge Functions) – NIEMALS mit VITE_ prefixen ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# ── Nur lokal (Skripte & E2E-Tests) – NIEMALS mit VITE_ prefixen ──
# Management-API: Migrationen, scripts/push-auth-templates.mjs (Dashboard → Account → Access Tokens)
SUPABASE_ACCESS_TOKEN=
# Admin-API für die E2E-Tests: Testnutzer ohne Mailversand anlegen (Dashboard → Project Settings → API Keys → service_role)
SUPABASE_SERVICE_ROLE_KEY=
